{
  "org_name": "simpl",
  "github_org": "simpl-techs",
  "knowledge_repo": "simpl_knowledge",
  "github_full_name": "simpl-techs/simpl_knowledge",
  "default_branch": "main",
  "marketplace_manifest": ".claude-plugin/marketplace.json",

  "rules_repo": {
    "github_full_name": "simpl-techs/simpl_rules",
    "default_branch": "main",
    "relative_path_to_repo": "."
  },

  "claude_plugin_cache_dir": "${HOME}/.claude/plugins/cache/simpl_knowledge",
  "cursor_rules_script": "./scripts/generate-cursor-rules.sh",
  "cursor_rules_output": "./.cursor/rules/simpl-standards.mdc",

  "git_identity": {
    "name": "simpl_knowledge-bot",
    "email": "bot@simpl.farm"
  },

  "plugin_publish": {
    "enabled": true,
    "commit_prefix": "release:",
    "dry_run_by_default": true
  }
}
